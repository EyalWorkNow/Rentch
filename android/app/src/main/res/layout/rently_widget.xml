<?xml version="1.0" encoding="utf-8"?>
<!--
  Rently home-screen widget. RTL-friendly (Hebrew): root forces RTL so the three
  stat columns read right-to-left and labels align correctly. Tapping anywhere
  opens MainActivity (PendingIntent attached to @id/widget_root in the provider).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Header row: brand title + teal accent dot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/rently_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="start" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/widget_stat_pill" />
    </LinearLayout>

    <!-- Stats row: matches | unread | likes (RTL order handled by parent) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ההתאמות שלך -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_stat_pill"
            android:padding="6dp">

            <TextView
                android:id="@+id/widget_matches_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_count"
                android:textColor="@color/rently_teal_light"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_label_matches"
                android:textColor="@color/rently_muted"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- הודעות שלא נקראו -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_stat_pill"
            android:padding="6dp">

            <TextView
                android:id="@+id/widget_unread_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_count"
                android:textColor="@color/rently_teal_light"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_label_unread"
                android:textColor="@color/rently_muted"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- לייקים -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_stat_pill"
            android:padding="6dp">

            <TextView
                android:id="@+id/widget_likes_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_count"
                android:textColor="@color/rently_teal_light"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_label_likes"
                android:textColor="@color/rently_muted"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
